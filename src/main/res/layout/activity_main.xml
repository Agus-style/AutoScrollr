<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵 TikTok AutoScrollr"
        android:textColor="#f0f0ff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔴 Tidak aktif"
        android:textColor="#fe2c55"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/tv_scroll_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video: 0"
        android:textColor="#25f4ee"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/tv_video_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Durasi: -"
        android:textColor="#6b6b8a"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingBottom="24dp"/>

    <android.support.v7.widget.SwitchCompat
        android:id="@+id/switch1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aktifkan Auto Scroll"
        android:textColor="#f0f0ff"
        android:paddingBottom="20dp"/>

    <!-- Card Accessibility -->
    <android.support.v7.widget.CardView
        android:id="@+id/card_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1a1a26"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="♿ Accessibility Service"
                android:textColor="#f0f0ff"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_access_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Belum"
                android:textSize="13sp"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <!-- Card Overlay -->
    <android.support.v7.widget.CardView
        android:id="@+id/card_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1a1a26"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🪟 Tampil di Atas Layar"
                android:textColor="#f0f0ff"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_overlay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Belum"
                android:textSize="13sp"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <Button
        android:id="@+id/btn_open_tiktok"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Buka TikTok"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:background="#fe2c55"/>

</LinearLayout>
